# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=

# Chat model (optional). Default: gemini-3.6-flash
CHAT_MODEL=

# --- Database (SQLite by default; for MySQL use e.g.
#     mysql+pymysql://airline_user:password@localhost/airline_assistant ) ---
# Leave blank to use backend/airline.db (absolute path, resolved from
# backend/ regardless of the working directory uvicorn was started in).
DATABASE_URL=

# --- Auth ---
# REQUIRED for anything but local development. Leaving this blank makes the
# backend generate a throwaway secret into backend/.dev_jwt_secret and warn.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=Rr_WTs29rB4H-wBI8HHVWw2vG_hNoiQeeTphCy1QQTBnA75OLQxOeTGK24KrY2uc

# --- SMTP escalation (optional; leave blank to record escalations without email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Escalation routing (optional) ---
# Where each department's escalation email is sent. Blank uses the
# skywings.example placeholders, which go nowhere.
BAGGAGE_EMAIL=
REFUNDS_EMAIL=
SPECIAL_ASSISTANCE_EMAIL=
SUPPORT_EMAIL=

# --- Optional tuning ---
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Longest passenger message accepted by /chat
MAX_MESSAGE_CHARS=2000
# Prior turns of a conversation sent to the model as memory
HISTORY_TURNS=6
