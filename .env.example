# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=

# --- Database (SQLite by default; for MySQL use e.g.
#     mysql+pymysql://airline_user:password@localhost/airline_assistant ) ---
DATABASE_URL=sqlite:///./airline.db

# --- Auth ---
JWT_SECRET=

# --- SMTP escalation (optional; leave blank to record escalations without email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
